---
import Base from '../../layouts/Base.astro';
import JoinRoom from '../../components/JoinRoom';
import RoomChat from '../../components/chat/RoomChat';
import { SESSION_COOKIE } from '../../components/auth/sessionCookie';
import { getServiceClient, verifyAccessTokenUser } from '../../lib/supabase/server';
import '../../../design/chat.css';

export const prerender = false;
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/');
}

// 1. Ambil data room dari database (SSR)
const service = getServiceClient();
const { data: roomRow } = await service
  .from('rooms')
  .select('id, name, created_by, status, visibility, closed_at, expires_at')
  .eq('slug', slug)
  .maybeSingle();

// 2. Deteksi apakah pengunjung adalah Host pembuat room ini
const token = Astro.cookies.get(SESSION_COOKIE)?.value;
const user = token ? await verifyAccessTokenUser(token) : null;
if (user && !user.isAnonymous && roomRow && roomRow.created_by === user.userId) {
  return Astro.redirect(`/dashboard/r/${roomRow.id}`);
}

const state = Astro.url.searchParams.get('state') ?? '';
const roomName = roomRow?.name ?? 'Room Chat';
---

<Base title={roomRow ? `${roomName} — room Guest` : 'Room tidak ditemukan — umpomenfess room'} noindex bare>
  {!roomRow ? (
    <div class="auth-stage">
      <div class="glass-card" style="max-width: 440px; margin: 0 auto; padding: 32px 24px; text-align: center;">
        <h1 style="font-size: var(--step-2); margin-bottom: 12px; color: var(--red-deep, #c53030);">
          Room Tidak Ditemukan
        </h1>
        <p style="color: var(--ink-soft); margin-bottom: 24px;">
          Room dengan tautan ini tidak ditemukan atau sudah kedaluwarsa dan dihapus permanen.
        </p>
        <a class="btn btn--primary btn--block" href="/">
          Kembali ke Beranda
        </a>
      </div>
    </div>
  ) : state === 'chat' || state === 'chat-mock' ? (
    <RoomChat client:load slug={slug} mode="GUEST" dev={import.meta.env.DEV} />
  ) : (
    <JoinRoom client:load slug={slug} dev={import.meta.env.DEV} />
  )}
</Base>

<style>
  .auth-stage {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }
</style>
