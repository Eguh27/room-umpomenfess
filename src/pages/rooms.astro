---
import Base from '../layouts/Base.astro';
import MyRooms from '../components/myrooms/MyRooms';
import { SESSION_COOKIE } from '../components/auth/sessionCookie';
import { verifyAccessTokenUser } from '../lib/supabase/server';

export const prerender = false;
const token = Astro.cookies.get(SESSION_COOKIE)?.value;
const user = token ? await verifyAccessTokenUser(token) : null;
const isAnonymous = user?.isAnonymous ?? true;
const isLoggedIn = Boolean(user && !user.isAnonymous);
---

<Base title="Ruang saya — umpomenfess room" noindex>
  <section class="narrow myrooms">
    <div class="row row--between" style="align-items: flex-start; margin-bottom: var(--space-4);">
      <div>
        <p class="eyebrow">{isLoggedIn ? 'Akun login · Guest' : 'Sesi Tamu'}</p>
        <h1>Ruang saya</h1>
      </div>
      {isLoggedIn && (
        <a class="btn btn--ghost" href="/dashboard">
          Dasbor Host
        </a>
      )}
    </div>

    {!user ? (
      <div class="card" style="padding: 32px 24px; text-align: center;">
        <h2>Masuk untuk melihat room kamu</h2>
        <p class="help" style="margin: 12px 0 20px;">
          Daftar "Ruang saya" tersimpan untuk pengguna yang masuk dengan akun.
        </p>
        <a class="btn btn--primary" href="/login?next=/rooms">
          Masuk ke Akun
        </a>
      </div>
    ) : isAnonymous ? (
      <div class="card">
        <h2>Kamu menggunakan sesi anonim</h2>
        <p>
          Sesi anonim hanya boleh mengikuti <strong>1 room aktif</strong> dalam satu waktu. Riwayat room disimpan langsung di browser perangkat ini.
        </p>
        <p class="help" style="margin: 12px 0 20px;">
          Ingin mengikuti hingga 5 room sekaligus dan menyimpannya lintas sesi? Masuk atau daftarkan akun Host/Guest.
        </p>
        <div class="row" style="gap: 8px;">
          <a class="btn btn--primary" href="/login?next=/rooms">
            Masuk / Buat Akun
          </a>
          <a class="btn btn--ghost" href="/">
            Beranda
          </a>
        </div>
      </div>
    ) : (
      <>
        <p class="myrooms__sub">
          Daftar room yang kamu ikuti dengan akun ini. Akun login dapat mengikuti hingga maksimum 5 room aktif secara bersamaan.
        </p>
        <MyRooms client:load />
      </>
    )}

    <div class="card" style="margin-top: var(--space-6);">
      <h2>Tentang penyimpanan room</h2>
      <p style="color: var(--ink-soft); margin-top: 8px;">
        Setiap room aktif selama 7 hari sebelum ditutup otomatis. Keanggotaanmu tersimpan aman di server dan dapat diakses kembali kapan saja selama room masih aktif.
      </p>
    </div>
  </section>
</Base>

<style>
  .myrooms {
    padding-top: var(--space-4);
  }
  .myrooms h1 {
    font-size: var(--step-3);
    margin-bottom: var(--space-1);
  }
  .myrooms__sub {
    color: var(--ink-soft);
    margin: 0 0 var(--space-5);
  }

  :global(.rooms) {
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  :global(.room) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-4);
    box-shadow: var(--shadow-sm);
  }
  :global(.room__info) {
    flex: 1 1 220px;
    min-width: 0;
  }
  :global(.room__info h3) {
    font-size: var(--step-0);
    margin: 0 0 2px;
  }
  :global(.room__meta) {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  :global(.room__actions) {
    margin-left: auto;
  }
</style>
