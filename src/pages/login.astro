---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import Base from '../layouts/Base.astro';
import AuthPanel from '../components/auth/AuthPanel';
import { safeNext } from '../components/auth/authMessages';

export const prerender = false;
const next = safeNext(Astro.url.searchParams.get('next'));
const siteKey = PUBLIC_TURNSTILE_SITE_KEY || undefined;
---

<Base title="Masuk Host — umpomenfess room" noindex>
  <section class="narrow auth">
    <p class="eyebrow">akun Host</p>
    <h1>Masuk</h1>
    <p class="auth__sub">
      Masuk dengan akun Host untuk membuat dan mengelola room. Guest login memakai halaman yang
      sama; Guest tanpa akun cukup membuka link room dari Host.
    </p>

    <AuthPanel client:load mode="login" next={next} dev={import.meta.env.DEV} siteKey={siteKey} />

    <p class="auth__alt">
      Belum punya akun? <a href={`/register?next=${encodeURIComponent(next)}`}>Daftar Host</a> ·
      Dapat link room? <strong>Guest cukup membuka link itu</strong>.
    </p>
  </section>
</Base>
