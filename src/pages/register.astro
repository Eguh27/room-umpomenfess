---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import Base from '../layouts/Base.astro';
import AuthPanel from '../components/auth/AuthPanel';
import { safeNext } from '../components/auth/authMessages';

export const prerender = false;
const next = safeNext(Astro.url.searchParams.get('next'));
const siteKey = PUBLIC_TURNSTILE_SITE_KEY || undefined;
---

<Base title="Daftar Host — umpomenfess room" noindex>
  <section class="narrow auth">
    <p class="eyebrow">akun Host</p>
    <h1>Daftar</h1>
    <p class="auth__sub">
      Akun Host dipakai untuk membuat room dan memegang moderasi. Satu akun bisa memegang 3 room
      aktif pada tier Free.
    </p>

    <AuthPanel
      client:load
      mode="register"
      next={next}
      dev={import.meta.env.DEV}
      siteKey={siteKey}
    />

    <p class="auth__alt">Sudah punya akun? <a href={`/login?next=${encodeURIComponent(next)}`}>Masuk</a></p>
  </section>
</Base>
