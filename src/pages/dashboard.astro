---
import Base from '../layouts/Base.astro';
import { categories, quota, publicQuota, hostRooms, newRoomPassword } from '../components/mockData';

export const prerender = false;
---

<Base title="Dasbor Host — umpomenfess room" noindex>
  <section class="dash">
    <div class="row row--between dash__head">
      <div>
        <p class="eyebrow">Host · tier {quota.tier}</p>
        <h1>Dasbor</h1>
      </div>
      <a class="btn btn--ghost" href="/rooms">
        Ruang saya (Guest)
      </a>
    </div>

    <!-- kuota -->
    <div class="quota">
      <span class="quota__label">Room aktif</span>
      <div
        class="quota__track"
        role="img"
        aria-label={`${quota.used} dari ${quota.max} room aktif terpakai`}
      >
        <div class="quota__fill" style={`width:${(quota.used / quota.max) * 100}%`}></div>
      </div>
      <span class="quota__num">
        {quota.used}/{quota.max}
      </span>
    </div>

    <!-- daftar room -->
    <h2 class="dash__section">Room kamu</h2>
    <ul class="rooms">
      {hostRooms.map((room) => (
        <li class:list={['room', { 'room--closed': room.status === 'CLOSED' }]}>
          <div class="room__info">
            <h3>{room.name}</h3>
            <p class="room__meta">
              {room.approvedCount}/{room.maxGuests} Guest · {room.endsIn} · mengetik{' '}
              {room.typingOn ? ' aktif' : ' mati'}
            </p>
          </div>
          <span class:list={['badge', room.status === 'ACTIVE' ? 'badge--active' : 'badge--muted']}>
            {room.status === 'ACTIVE' ? 'AKTIF' : 'TUTUP'}
          </span>
          <span
            class:list={['badge', room.visibility === 'PUBLIC' ? 'badge--pending' : 'badge--muted']}
          >
            {room.visibility === 'PUBLIC' ? 'PUBLIK' : 'PRIVAT'}
          </span>
          {room.pendingCount > 0 && (
            <span class="badge badge--pending">{room.pendingCount} nunggu</span>
          )}
          <div class="room__actions">
            <a class="btn btn--sm btn--brand" href={`/dashboard/r/${room.id}`}>
              {room.status === 'ACTIVE' ? 'Kelola' : 'Lihat'}
            </a>
          </div>
        </li>
      ))}
    </ul>

    <!-- form buat room -->
    <h2 class="dash__section">Buat room</h2>
    {quota.used >= quota.max ? (
      <div class="card quota-full" role="status">
        <h3>
          Batas room aktif tercapai ({quota.used}/{quota.max})
        </h3>
        <p>
          Tutup salah satu room biar bisa bikin baru. Pembayaran belum tersedia — semua tier disetel
          lewat konfigurasi manual.
        </p>
      </div>
    ) : (
      <>
        <form
          class="glass-card create"
          method="post"
          action="/dashboard/rooms"
          novalidate
          data-create-room
        >
          <div class="field">
            <label for="name">Nama room</label>
            <input
              class="input"
              id="name"
              name="name"
              type="text"
              maxlength="80"
              placeholder="Rapat & Koordinasi KKN"
              required
            />
            <p class="help">Tampak di bar room. Maksimum 80 karakter.</p>
          </div>

          <fieldset class="create__visibility">
            <legend>Visibilitas room</legend>
            <div class="create__choices">
              <label class="choice">
                <input type="radio" name="visibility" value="PRIVATE" checked />
                <span class="choice__body">
                  <strong>Privat</strong>
                  <span class="help">Link + password. Tidak tampil di FYP.</span>
                </span>
              </label>
              <label class="choice">
                <input type="radio" name="visibility" value="PUBLIC" />
                <span class="choice__body">
                  <strong>Publik</strong>
                  <span class="help">Tanpa password. Metadata tampil di FYP.</span>
                </span>
              </label>
            </div>
            <p class="help">
              Visibilitas dikunci setelah room dibuat. Hanya publik → privat; privat tidak bisa
              menjadi publik.
            </p>
          </fieldset>

          <div class="create__notice" role="note">
            <strong>Room publik:</strong> isi chat dapat dibaca dan disalin siapa pun yang join.
            Jangan menulis data pribadi atau hal yang tidak ingin tersebar.
          </div>

          <div class="field">
            <label for="description">Deskripsi</label>
            <textarea
              class="input"
              id="description"
              name="description"
              maxlength="200"
              rows="3"
              placeholder="Ruang cerita ringan untuk mahasiswa. Jangan bagikan data pribadi."
            ></textarea>
            <p class="help">Tampil di FYP untuk room publik. Maksimum 200 karakter.</p>
          </div>

          <div class="field">
            <label for="category">Kategori</label>
            <select class="select" id="category" name="category">
              {categories.map((category) => (
                <option value={category}>{category}</option>
              ))}
            </select>
            <p class="help">
              Dipakai filter FYP; room privat tetap menyimpan kategori untuk arsip.
            </p>
          </div>

          <p class="create__quota">
            Kuota publik:{' '}
            <strong>
              {publicQuota.used}/{publicQuota.max}
            </strong>{' '}
            room publik aktif terpakai. Room publik wajib memakai email terkonfirmasi.
          </p>

          <div class="field">
            <label for="capacity">Kapasitas Guest</label>
            <input
              id="capacity"
              name="max_guests"
              type="range"
              min="2"
              max="40"
              value="16"
              step="1"
            />
            <output class="create__out" for="capacity">
              16 Guest
            </output>
            <p class="help">
              <strong>Batasmu: 40 (tier Free).</strong> Melebihi batas ini memerlukan tier lebih
              tinggi.
            </p>
          </div>

          <div class="create__toggles">
            <label class="toggle">
              <input type="checkbox" name="approval_required" />
              <span class="toggle__track"></span>
              <span class="toggle__label">Persetujuan masuk manual</span>
            </label>
            <p class="help">Guest menunggu di lobi sampai kamu menyetujui.</p>

            <label class="toggle">
              <input type="checkbox" name="typing_enabled" checked />
              <span class="toggle__track"></span>
              <span class="toggle__label">Indikator mengetik</span>
            </label>
            <p class="help">Otomatis mati bila kanal global dimatikan atau kapasitas &gt; 20.</p>
          </div>

          <div class="field">
            <label for="idle">Keluarkan Guest yang diam</label>
            <select class="select" id="idle" name="idle_timeout_minutes">
              <option value="10">10 menit</option>
              <option value="15">15 menit (default publik)</option>
              <option value="30" selected>
                30 menit (default privat)
              </option>
              <option value="60">60 menit</option>
              <option value="120">120 menit</option>
              <option value="240">240 menit</option>
            </select>
            <p class="help">Guest yang keluar otomatis bisa masuk lagi tanpa password baru.</p>
          </div>

          <button class="btn btn--primary btn--block" type="submit" disabled>
            Buat room
          </button>
          <p class="help">Tombol diaktifkan setelah form menerima fungsionalnya (T-51).</p>

          <details class="pwonce">
            <summary>Lihat panel password room (privat)</summary>
            <div class="pwonce__panel">
              <span class="st-tag">✧ password tampil sekali</span>
              <p class="pwonce__code">{newRoomPassword}</p>
              <p class="help">Simpan di tempat aman sekarang — tidak bisa ditampilkan lagi.</p>
              <div class="row">
                <button class="btn btn--sm btn--ghost" type="button" disabled>
                  Buat baru (ganti versi)
                </button>
              </div>
            </div>
          </details>

          <details class="pwonce">
            <summary>Lihat panel "Jadikan privat" (room publik)</summary>
            <div class="pwonce__panel">
              <span class="st-tag">✧ jadikan privat</span>
              <p class="help">
                Room publik turun dari FYP dan password baru tampil sekali. Tindakan ini tidak bisa
                dibalik menjadi publik lagi.
              </p>
              <p class="pwonce__code">{newRoomPassword}</p>
              <div class="row">
                <button class="btn btn--sm btn--ghost-danger" type="button" disabled>
                  Jadikan privat
                </button>
              </div>
            </div>
          </details>
        </form>
        <script>
          /**
           * Sinkron default keluar-otomatis dengan visibilitas yang dipilih:
           * 15 menit untuk room publik (public_idle_default_minutes), 30 menit untuk privat.
           * Ter-bundle sebagai module (bukan inline) agar cukup script-src 'self' (T-22).
           */
          const formCreate = document.querySelector<HTMLFormElement>('[data-create-room]');
          if (formCreate) {
            const idleSelect = formCreate.querySelector<HTMLSelectElement>('#idle');
            const syncIdleDefault = () => {
              const checked = formCreate.querySelector<HTMLInputElement>(
                'input[name="visibility"]:checked',
              );
              if (idleSelect && checked)
                idleSelect.value = checked.value === 'PUBLIC' ? '15' : '30';
            };
            formCreate
              .querySelectorAll<HTMLInputElement>('input[name="visibility"]')
              .forEach((input) => input.addEventListener('change', syncIdleDefault));
          }
        </script>
      </>
    )}
  </section>
</Base>

<style>
  .dash {
    display: flex;
    flex-direction: column;
  }
  .dash__head {
    align-items: flex-start;
    margin-bottom: var(--space-5);
  }
  .dash h1 {
    font-size: var(--step-3);
    margin: 0;
  }

  .quota {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
    box-shadow: var(--shadow-sm);
    max-width: 480px;
  }
  .quota__label {
    flex: none;
    font: 700 0.875rem var(--font-sans);
    color: var(--ink);
  }
  .quota__track {
    flex: 1;
    height: 10px;
    border-radius: var(--radius-pill);
    background: var(--paper);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .quota__fill {
    height: 100%;
    background: var(--teal-strong);
    border-radius: var(--radius-pill);
  }
  .quota__num {
    flex: none;
    font: 700 0.875rem var(--font-mono);
    color: var(--teal-strong);
  }

  .dash__section {
    font-size: var(--step-1);
    margin: var(--space-6) 0 var(--space-3);
  }
  .rooms {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .room {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-4);
    box-shadow: var(--shadow-sm);
  }
  .room--closed {
    opacity: 0.72;
  }
  .room__info {
    flex: 1 1 240px;
    min-width: 0;
  }
  .room__info h3 {
    font-size: var(--step-0);
    margin: 0 0 2px;
  }
  .room__meta {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .room__actions {
    margin-left: auto;
  }

  .quota-full h3 {
    font-size: var(--step-1);
    margin-bottom: var(--space-2);
  }
  .quota-full p {
    margin: 0;
    color: var(--ink-soft);
  }

  .create {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 560px;
  }
  .create .field {
    margin-bottom: 0;
  }
  .create__visibility {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .create__visibility legend {
    font: 700 0.9375rem / 1.3 var(--font-sans);
    color: var(--ink);
    margin-bottom: 8px;
  }
  .create__choices {
    display: grid;
    gap: var(--space-2);
  }
  .choice {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    background: var(--surface);
    cursor: pointer;
  }
  .choice:has(input:checked) {
    border-color: var(--teal-strong);
    background: var(--ok-soft);
  }
  .choice input {
    margin-top: 4px;
    accent-color: var(--teal-strong);
  }
  .choice__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .choice__body strong {
    color: var(--ink);
  }
  .create__notice {
    border: 1.5px dashed var(--border-dash);
    border-radius: var(--radius-sm);
    background: var(--paper);
    padding: var(--space-3);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  .create__notice strong {
    color: var(--ink);
  }
  .create__quota {
    margin: 0;
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .create__quota strong {
    color: var(--teal-strong);
    font-family: var(--font-mono);
  }
  .create textarea.input {
    min-height: 96px;
    resize: vertical;
  }
  .create__out {
    font: 700 var(--step-0) var(--font-mono);
    color: var(--teal-strong);
  }
  .create__toggles {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border: 1.5px dashed var(--border-dash);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
  }
  .pwonce {
    margin-top: var(--space-2);
  }
  .pwonce summary {
    cursor: pointer;
    font: 700 0.875rem var(--font-sans);
    color: var(--teal-strong);
  }
  .pwonce__panel {
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    border: 1.5px dashed var(--border-dash);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
  }
  .pwonce__code {
    margin: 0;
    font: 700 var(--step-2) var(--font-mono);
    letter-spacing: 0.3em;
    color: var(--ink);
  }
</style>
