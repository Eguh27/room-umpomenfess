---
/** Dasbor Host nyata (T-51). Guard ringan SSR: cookie cermin sesi (T-50)
    diverifikasi ke Supabase; Guest anonim tidak punya dasbor → /rooms.
    Data & aksi berada di island (RPC lewat browser client, identitas auth.uid()). */
import Base from '../layouts/Base.astro';
import DashboardRooms from '../components/host/DashboardRooms';
import { SESSION_COOKIE } from '../components/auth/sessionCookie';
import { verifyAccessTokenUser } from '../lib/supabase/server';

export const prerender = false;
const token = Astro.cookies.get(SESSION_COOKIE)?.value;
const user = token ? await verifyAccessTokenUser(token) : null;

if (!user) return Astro.redirect('/login?next=/dashboard');
if (user.isAnonymous) return Astro.redirect('/rooms');
---

<Base title="Dasbor Host — umpomenfess room" noindex>
  <section class="dash">
    <div class="row row--between dash__head">
      <div>
        <p class="eyebrow">Host</p>
        <h1>Dasbor</h1>
      </div>
      <a class="btn btn--ghost" href="/rooms">
        Ruang saya (Guest)
      </a>
    </div>

    <DashboardRooms client:load dev={import.meta.env.DEV} />
  </section>
</Base>
